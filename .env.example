# Public URL of the site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Keystatic admin in production (GitHub mode). Leave unset to use local mode in dev only.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=iam-wrath/kj-portfolio
# Generated by Keystatic's GitHub App setup — server-side secrets, never commit real values
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
